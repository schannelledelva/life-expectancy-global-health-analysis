  -- Second View
CREATE OR ALTER VIEW v_Dim_Geography AS
SELECT DISTINCT 
    -- Creation of a unique ID number for every unique country
    DENSE_RANK() OVER (ORDER BY Country) AS CountryKey,
    Country,
    Continent
FROM v_Dim_continent
WHERE Country IS NOT NULL; 
GO
  -- Third view
CREATE VIEW v_Dim_Status AS
SELECT DISTINCT 
    -- To assign a simple ID number based on status
    CASE WHEN LOWER(Status) LIKE 'develop_d' THEN 1 ELSE 2 END AS StatusKey,
    -- To Standardize the spelling 
    CASE WHEN LOWER(Status) LIKE 'develop_d' THEN 'Developed' ELSE 'Developing' END AS StatusName    
FROM LifeExpectancy
WHERE Status IS NOT NULL;
GO

  -- Fourth view
CREATE OR ALTER VIEW v_Dim_Date AS
SELECT DISTINCT 
    [Year] AS YearKey,      -- The numerical ID for relationships
    [Year] AS Year  -- The label that will display on charts
FROM LifeExpectancy
WHERE [Year] IS NOT NULL;
GO

  -- Fifth View
CREATE VIEW v_Fact_LifeExpectancy AS
SELECT 
    g.CountryKey,
    s.StatusKey,
    le.[Year] AS YearKey,
    CAST(le.Life_expectancy AS DECIMAL(5,2)) AS Life_Expectancy,
    CAST(le.GDP AS DECIMAL(12,2)) AS GDP,
    CAST(le.Schooling AS DECIMAL(4,1)) AS Schooling,
    CAST(le.Adult_Mortality AS INT) AS Adult_Mortality,
    CAST(le.Infant_deaths AS INT) AS Infant_Deaths
FROM LifeExpectancy le
INNER JOIN v_Dim_Geography g ON le.Country = g.Country
INNER JOIN v_Dim_Status s ON 
    (CASE WHEN LOWER(le.Status) LIKE 'develop_d' THEN 'Developed' ELSE 'Developing' END) = s.StatusName
WHERE le.Life_expectancy IS NOT NULL; 
  GO


